{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
    "bundle": {
      "additionalProperties": {},
      "properties": {
        "detected": {
          "type": "boolean"
        },
        "patch": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "patchExists": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "detected",
        "patch",
        "patchExists"
      ],
      "type": "object"
    },
    "crawl": {
      "additionalProperties": {},
      "properties": {
        "enrichedAt": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
        },
        "enrichmentStatus": {
          "enum": [
            "ok",
            "partial",
            "stale",
            "failed"
          ],
          "type": "string"
        },
        "headSha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "headSha",
        "enrichmentStatus",
        "enrichedAt"
      ],
      "type": "object"
    },
    "github": {
      "additionalProperties": {},
      "properties": {
        "archived": {
          "type": "boolean"
        },
        "createdAt": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
        },
        "databaseId": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "defaultBranch": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "fork": {
          "type": "boolean"
        },
        "forks": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "headSha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "homepageUrl": {
          "anyOf": [
            {
              "format": "uri",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "license": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "anyOf": [
                    {
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "spdxId": {
                  "anyOf": [
                    {
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "spdxId",
                "name"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "nodeId": {
          "minLength": 1,
          "type": "string"
        },
        "openGraphImageUrl": {
          "anyOf": [
            {
              "format": "uri",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner": {
          "additionalProperties": {},
          "properties": {
            "avatarUrl": {
              "format": "uri",
              "type": "string"
            },
            "login": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "login",
            "avatarUrl"
          ],
          "type": "object"
        },
        "pushedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "slug": {
          "pattern": "^[^/]+\\/[^/]+$",
          "type": "string"
        },
        "stars": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "topics": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "updatedAt": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "databaseId",
        "nodeId",
        "slug",
        "url",
        "defaultBranch",
        "headSha",
        "owner",
        "description",
        "homepageUrl",
        "topics",
        "stars",
        "forks",
        "archived",
        "fork",
        "language",
        "license",
        "createdAt",
        "updatedAt",
        "pushedAt",
        "openGraphImageUrl"
      ],
      "type": "object"
    },
    "id": {
      "pattern": "^gh:[0-9]+$",
      "type": "string"
    },
    "install": {
      "additionalProperties": {},
      "properties": {
        "available": {
          "type": "boolean"
        },
        "packageName": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "preferred": {
          "anyOf": [
            {
              "enum": [
                "npm",
                "github"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "requiresBuildApproval": {
          "type": "boolean"
        },
        "spec": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "available",
        "preferred",
        "spec",
        "packageName",
        "version",
        "requiresBuildApproval",
        "reason"
      ],
      "type": "object"
    },
    "npm": {
      "additionalProperties": {},
      "properties": {
        "latestVersion": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "published": {
          "type": "boolean"
        },
        "repositoryMatches": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "published",
        "latestVersion",
        "repositoryMatches"
      ],
      "type": "object"
    },
    "package": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": {},
          "properties": {
            "status": {
              "const": "invalid",
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        {
          "additionalProperties": {},
          "properties": {
            "exports": {},
            "main": {
              "anyOf": [
                {
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "name": {
              "anyOf": [
                {
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "const": "valid",
              "type": "string"
            },
            "type": {
              "anyOf": [
                {
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "version": {
              "anyOf": [
                {
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "name",
            "version",
            "type",
            "main"
          ],
          "type": "object"
        }
      ]
    },
    "presentation": {
      "additionalProperties": {},
      "properties": {
        "coverUrl": {
          "anyOf": [
            {
              "format": "uri",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "description",
        "coverUrl"
      ],
      "type": "object"
    },
    "readme": {
      "additionalProperties": {},
      "properties": {
        "available": {
          "type": "boolean"
        },
        "excerpt": {
          "type": "string"
        }
      },
      "required": [
        "available",
        "excerpt"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "scripts": {
      "additionalProperties": {},
      "properties": {
        "install": {
          "type": "boolean"
        },
        "postinstall": {
          "type": "boolean"
        },
        "preinstall": {
          "type": "boolean"
        },
        "prepare": {
          "type": "boolean"
        }
      },
      "required": [
        "prepare",
        "preinstall",
        "install",
        "postinstall"
      ],
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "github",
    "presentation",
    "readme",
    "package",
    "bundle",
    "scripts",
    "npm",
    "install",
    "crawl"
  ],
  "type": "object"
}
