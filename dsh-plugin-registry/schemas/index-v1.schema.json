{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
    "plugins": {
      "items": {
        "additionalProperties": {},
        "properties": {
          "coverUrl": {
            "anyOf": [
              {
                "format": "uri",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "type": "string"
          },
          "detailPath": {
            "pattern": "^\\.\\/plugins\\/[0-9]+\\.json$",
            "type": "string"
          },
          "githubDatabaseId": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "githubNodeId": {
            "minLength": 1,
            "type": "string"
          },
          "homepageUrl": {
            "anyOf": [
              {
                "format": "uri",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "pattern": "^gh:[0-9]+$",
            "type": "string"
          },
          "install": {
            "additionalProperties": {},
            "properties": {
              "available": {
                "type": "boolean"
              },
              "packageName": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "requiresBuildApproval": {
                "type": "boolean"
              },
              "version": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "available",
              "packageName",
              "version",
              "requiresBuildApproval"
            ],
            "type": "object"
          },
          "language": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "license": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "owner": {
            "additionalProperties": {},
            "properties": {
              "avatarUrl": {
                "format": "uri",
                "type": "string"
              },
              "login": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "login",
              "avatarUrl"
            ],
            "type": "object"
          },
          "repositoryUrl": {
            "format": "uri",
            "type": "string"
          },
          "slug": {
            "pattern": "^[^/]+\\/[^/]+$",
            "type": "string"
          },
          "state": {
            "additionalProperties": {},
            "properties": {
              "archived": {
                "type": "boolean"
              },
              "fork": {
                "type": "boolean"
              }
            },
            "required": [
              "archived",
              "fork"
            ],
            "type": "object"
          },
          "stats": {
            "additionalProperties": {},
            "properties": {
              "forks": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "stars": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "stars",
              "forks"
            ],
            "type": "object"
          },
          "timestamps": {
            "additionalProperties": {},
            "properties": {
              "createdAt": {
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "type": "string"
              },
              "pushedAt": {
                "anyOf": [
                  {
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "updatedAt": {
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "type": "string"
              }
            },
            "required": [
              "createdAt",
              "updatedAt",
              "pushedAt"
            ],
            "type": "object"
          },
          "topics": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "githubDatabaseId",
          "githubNodeId",
          "slug",
          "name",
          "owner",
          "repositoryUrl",
          "homepageUrl",
          "description",
          "coverUrl",
          "topics",
          "language",
          "license",
          "stats",
          "state",
          "timestamps",
          "install",
          "detailPath"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "revision": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "plugins"
  ],
  "type": "object"
}
