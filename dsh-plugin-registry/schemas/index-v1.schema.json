{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
    "plugins": {
      "items": {
        "additionalProperties": {},
        "properties": {
          "ai": {
            "additionalProperties": false,
            "properties": {
              "evidence": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "fact": {
                      "maxLength": 300,
                      "minLength": 1,
                      "type": "string"
                    },
                    "paragraph_id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "quote": {
                      "maxLength": 120,
                      "minLength": 20,
                      "type": "string"
                    }
                  },
                  "required": [
                    "paragraph_id",
                    "quote",
                    "fact"
                  ],
                  "type": "object"
                },
                "maxItems": 3,
                "minItems": 1,
                "type": "array"
              },
              "limitations": {
                "items": {
                  "maxLength": 300,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 5,
                "type": "array"
              },
              "model": {
                "minLength": 1,
                "type": "string"
              },
              "originalDescription": {
                "type": "string"
              },
              "promptVersion": {
                "minLength": 1,
                "type": "string"
              },
              "reviewLevel": {
                "enum": [
                  "human-reviewed",
                  "batch-approved",
                  "automated"
                ],
                "type": "string"
              },
              "reviewedAt": {
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "type": "string"
              },
              "sourceHeadSha": {
                "pattern": "^[0-9a-f]{40}$",
                "type": "string"
              },
              "sourceInputHash": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              "status": {
                "const": "approved",
                "type": "string"
              },
              "summaryZh": {
                "maxLength": 140,
                "minLength": 15,
                "type": "string"
              },
              "tags": {
                "items": {
                  "maxLength": 30,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 5,
                "minItems": 2,
                "type": "array"
              }
            },
            "required": [
              "status",
              "summaryZh",
              "tags",
              "sourceInputHash",
              "sourceHeadSha",
              "model",
              "promptVersion",
              "reviewLevel",
              "reviewedAt",
              "originalDescription",
              "limitations",
              "evidence"
            ],
            "type": "object"
          },
          "category": {
            "enum": [
              "agents-automation",
              "coding-development",
              "search-research",
              "knowledge-memory",
              "files-data",
              "media-creation",
              "communication-integrations",
              "interface-personalization",
              "security-operations",
              "other"
            ],
            "type": "string"
          },
          "coverUrl": {
            "anyOf": [
              {
                "format": "uri",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "type": "string"
          },
          "detailHash": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "detailPath": {
            "pattern": "^\\.\\/plugins\\/[0-9]+\\.json$",
            "type": "string"
          },
          "githubDatabaseId": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "githubNodeId": {
            "minLength": 1,
            "type": "string"
          },
          "homepageUrl": {
            "anyOf": [
              {
                "format": "uri",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "pattern": "^gh:[0-9]+$",
            "type": "string"
          },
          "install": {
            "additionalProperties": {},
            "properties": {
              "available": {
                "type": "boolean"
              },
              "packageName": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "requiresBuildApproval": {
                "type": "boolean"
              },
              "version": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "available",
              "packageName",
              "version",
              "requiresBuildApproval"
            ],
            "type": "object"
          },
          "language": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "license": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "owner": {
            "additionalProperties": {},
            "properties": {
              "avatarUrl": {
                "format": "uri",
                "type": "string"
              },
              "login": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "login",
              "avatarUrl"
            ],
            "type": "object"
          },
          "repositoryUrl": {
            "format": "uri",
            "type": "string"
          },
          "slug": {
            "pattern": "^[^/]+\\/[^/]+$",
            "type": "string"
          },
          "state": {
            "additionalProperties": {},
            "properties": {
              "archived": {
                "type": "boolean"
              },
              "fork": {
                "type": "boolean"
              }
            },
            "required": [
              "archived",
              "fork"
            ],
            "type": "object"
          },
          "stats": {
            "additionalProperties": {},
            "properties": {
              "forks": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "stars": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "stars",
              "forks"
            ],
            "type": "object"
          },
          "timestamps": {
            "additionalProperties": {},
            "properties": {
              "createdAt": {
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "type": "string"
              },
              "pushedAt": {
                "anyOf": [
                  {
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "updatedAt": {
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "type": "string"
              }
            },
            "required": [
              "createdAt",
              "updatedAt",
              "pushedAt"
            ],
            "type": "object"
          },
          "topics": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "githubDatabaseId",
          "githubNodeId",
          "slug",
          "name",
          "owner",
          "repositoryUrl",
          "homepageUrl",
          "description",
          "coverUrl",
          "topics",
          "language",
          "license",
          "stats",
          "state",
          "timestamps",
          "install",
          "detailPath"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "revision": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "plugins"
  ],
  "type": "object"
}
