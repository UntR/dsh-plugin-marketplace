{
  "name": "dsh-plugin-marketplace-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "ai": "python3 tools/ai-catalog/cli.py",
    "ai:test": "python3 -m unittest discover -s tools/ai-catalog -p 'test_*.py' -v",
    "publish:registry": "pnpm --filter dsh-plugin-registry publish:registry"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
