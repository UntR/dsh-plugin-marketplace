{"archiveSha256":"e3a7e133bb63c9ec453887d3f8100c8c52445ca7bd06fde35b41c3dec0071420","distTags":{"latest":"4.1.0"},"id":"gh:1415822787","integrity":"sha512-sDrCW/Sz4HHkiu1p7TNwgD/BxVxpb5b1h7cjEiYlZU7opIWE8HnQU017C0fO4GBNdSNl63zwhICZrj8PpHxj+g==","manifest":{"author":"空气凤梨 <feiyu-memory@users.noreply.github.com>","bugs":{"url":"https://github.com/AirPineApplea/feiyu-memory/issues"},"description":"给 DeepSeek Harness 一条会记事的蓝色大肥鱼：跨会话的持久人格与日记。每轮结束后固化模型只回答一句「你想记什么」，写下的每条日记配一句十几二十字的索引；下一场对话注入人格、手记和最近的几条，想知道更早的事它自己调 feiyu_recall，插件读索引挑出相关的那几条，正文才进上下文——索引永远不进它的视野，所以它看到的是日子，不是检索结果。遗忘是降权而不是删除。全程本地、发送前先拦掉密钥，档案是一个可读可改、能换账号带走的普通文件夹。零运行时依赖，无构建步骤。","dsh":{"bundle":{"patch":"./cordis.patch.yml"},"client":{"platform":"web"},"manifestVersion":1},"engines":{"dsh":">=0.2.0-rc.2","node":">=22"},"exports":{".":"./src/host/index.mjs","./client":"./src/client/index.js","./locale/*.json":"./locale/*.json","./package.json":"./package.json"},"files":["src","cordis.patch.yml","locale","README.md","CHANGELOG.md","LICENSE","SPEC.md"],"homepage":"https://github.com/AirPineApplea/feiyu-memory#readme","keywords":["dsh","dsh-plugin","deepseek-harness","memory","persona","diary"],"license":"MIT","name":"feiyu-memory","peerDependencies":{"@deepseek-ai/cordis":"~4.0.4"},"publishConfig":{"access":"public"},"repository":{"type":"git","url":"git+https://github.com/AirPineApplea/feiyu-memory.git"},"scripts":{"check":"node tools/check-patch-yaml.mjs","doctor":"node tools/doctor.mjs","preview":"node tools/preview-memory.mjs","test":"node --test"},"type":"module","version":"4.1.0"},"patchSha256":"fb5f252471bbd50006144ad9b1127b1a1f40195029fae596ddb6ccfade498bc3","publishTime":"2026-11-08T13:40:19.992Z","schemaVersion":1,"source":{"type":"npm"},"verificationLevel":"metadata-verified","verifiedAt":1794246122.701893,"version":"4.1.0"}
