{"archiveSha256":"d2a4ef4bc8a8894fd08c8e51f0f2465a4f16b02ad4a4b16603180772f81e202d","distTags":{"latest":"1.2.4"},"id":"gh:1409724830","manifest":{"_comment":["=============== 仓库根清单：既是构建入口，也是 DSH 插件的「门面」 ===============","插件的真实包在 src/：那里才有 lib/（宿主半侧 + 浏览器半侧构建产物）、assets/（106 个 webm）和 cordis.patch.yml。","为什么根目录也声明 dsh.bundle —— 一批目录/工具只把『仓库根』当成安装目标，会生成","    dsh plugin add github:12we21/cute-fat-fish-pet","（dshbase 的 gen-catalog.py、bradeGithub/DSH-Plugins-Marketplace、ukinch605/awesome-dsh-hub 的收录条件、","以及 dshfind 的 is_plugin 判定都是这个口径）。根清单没有 dsh.bundle 时，这条命令装不上任何东西，","仓库也会被判成「不是插件」。子目录指向（#path:/src）依然有效，两种装法并存。","main / exports 一律指向 src/ —— src/lib/index.js 里 PACKAGE_ROOT = resolve(new URL('..', import.meta.url))","是模块相对解析，所以无论从仓库根装还是从 src/ 装，assets/ 都能找到。","本清单不参与 Electron / NSIS 打包；打包入口是下面的 scripts（node build/build.mjs 等）。","================================================"],"author":"Mikolu","dependencies":{"@electron-internal/extract-zip":"^1.0.5","@electron/get":"^5.1.0"},"description":"Cute Fat Fish Pet — a chibi blue-haired maid who lives on your Windows desktop (source repository; build entry point)","dsh":{"bundle":{"patch":"./src/cordis.patch.yml"},"client":{"inject":["@deepseek-ai/dsh-client-connection"],"platform":"web"}},"engines":{"dsh":">=0.2.0-rc.1","node":">=20"},"exports":{".":{"default":"./src/lib/index.js","types":"./src/lib/types/index.d.ts"},"./client":{"default":"./src/lib/client.js","types":"./src/lib/types/client/index.d.ts"},"./cordis.patch.yml":"./src/cordis.patch.yml","./package.json":"./package.json"},"homepage":"https://github.com/12we21/cute-fat-fish-pet","license":"MIT","main":"src/lib/index.js","name":"cute-fat-fish-pet","peerDependencies":{"@deepseek-ai/cordis":"^4.0.4","@deepseek-ai/dsh-agent-default-model":"^0.2.0-rc.1","@deepseek-ai/dsh-client-connection":"^0.2.0-rc.1","@deepseek-ai/dsh-client-ui-slots":"^0.2.0-rc.1","@deepseek-ai/dsh-commands":"^0.2.0-rc.1","@deepseek-ai/dsh-credentials":"^0.2.0-rc.1","@deepseek-ai/dsh-home-paths":"^0.2.0-rc.1","@deepseek-ai/dsh-host-webserver":"^0.2.0-rc.1","@deepseek-ai/dsh-llm":"^0.2.0-rc.1","react":"^18.2.0"},"private":true,"scripts":{"build":"node build/build.mjs","check":"node build/check-release.mjs","clean":"node build/build.mjs --clean","exe":"python build/mkexe.py","list":"node build/build.mjs --list","nsi":"python build/nsi-syntax-check.py","paths":"node build/check-paths.mjs","toolchain":"node build/toolchain.mjs","upstream":"node build/compare-upstream.mjs","verify":"node stage/verify.mjs","zip":"python build/mkzip.py"},"version":"1.2.4","workspaces":["src"]},"patchSha256":"61e30d70d1eb0b912bdb5abe782267aca8867c4a3cac50d3be863ece0e79da86","publishTime":"2026-10-27T15:15:09Z","schemaVersion":1,"source":{"commit":"652c4abb3075e574b6fa5d68b79c8aadbaf7b6e7","type":"git","url":"https://github.com/12we21/cute-fat-fish-pet"},"verificationLevel":"metadata-verified","verifiedAt":1794243422.7352414,"version":"1.2.4"}
