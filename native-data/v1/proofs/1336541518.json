{"archiveSha256":"3ba7a6d4709e46b2154e12edf1502725352f33ae4b27f1f09d5c91551aaeb9de","distTags":{"latest":"0.2.24"},"id":"gh:1336541518","integrity":"sha512-MVu0f24FpFPFpIlgDOPTvz7qmsY+vkuSc2nLTDHJTXDVPQwvCksbc7MQ4g3N3HJE31D91H4d1OzRtheEApsD+A==","manifest":{"author":"PerryLink","bugs":{"url":"https://github.com/PerryLink/dsh-mask/issues"},"dependencies":{"zod":"4.4.3"},"description":"PII masking middleware for DeepSeek Harness: regex-detect and replace phones, emails, ID cards, bank cards, keys, and (opt-in) IPs with placeholders before they reach the model, keep the restore table host-side (memory plus a controlled storage domain, never the session log) with the /mask restore command and the exported RestoreStore seam, and expose /mask status and the mask_test tool. Name and address recognition needs an external NER recognizer, which this pure-host form does not bundle: mode \"regex+ner\" and the person/address entities fail loudly at load. The phone and ID-card detectors match mainland-China formats only.","devDependencies":{"@deepseek-ai/cordis":"^4.1.0","@deepseek-ai/cordis-plugin-include":"^1.1.0","@deepseek-ai/cordis-plugin-loader":"^1.1.0","@deepseek-ai/dsh-agent":"0.2.2-rc.1","@deepseek-ai/dsh-attachment":"0.2.2-rc.1","@deepseek-ai/dsh-commands":"0.2.2-rc.1","@deepseek-ai/dsh-session":"0.2.2-rc.1","@deepseek-ai/dsh-storage":"0.2.2-rc.1","@deepseek-ai/dsh-storage-domain":"0.2.2-rc.1","@deepseek-ai/dsh-storage-json":"0.2.2-rc.1","@deepseek-ai/dsh-system-prompt":"0.2.2-rc.1","@deepseek-ai/dsh-tools":"0.2.2-rc.1","@deepseek-ai/dsh-working-directory":"0.2.2-rc.1","@deepseek-ai/schemastery":"~3.19.0","@types/node":"^22.20.5","oxlint":"0.18.1","typescript":"^5.9.0"},"dsh":{"bundle":{"patch":"./cordis.patch.yml"},"manifestVersion":1},"dshWorkshop":{"capability":{"expected":"the /mask command is registered on the commands service: status reports masked counts and type distribution, on/off toggles masking at runtime, restore <text> unmaps placeholders back to the values stored for this session and delivers the plaintext as a controlled file whose path (never the plaintext) is what the command result and the session log carry; mask_test tool masks a snippet and reports the placeholder result","id":"mask","invocation":"/mask status","kind":"command"},"compatibility":{"dshVersions":["0.1.2-rc.1","0.1.5-rc.2","0.1.7-alpha.2","0.1.7-rc.1","0.1.7-rc.2","0.2.1-alpha.1","0.2.1-rc.2"]},"evidence":{"failureIsolation":null,"hotReload":null,"install":null,"remove":null},"install":{"adapter":"profile-bundle","failurePolicy":"generation-rollback","mode":"transactional","touchesCurrentBeforeActivation":false},"integration":{"artifact":"cordis.patch.yml","protocol":"harness-profile"},"lifecycle":{"activation":"restart-profile","dispose":"supported"},"permissions":["filesystem:read","filesystem:write","storage-domain:read","storage-domain:write","session-log:read","credentials:none","network:none"],"schema":"omdsh-workshop-package/v1","type":"plugin"},"engines":{"dsh":">=0.1.2-rc.1 <0.2.0 || >=0.1.5-alpha.1 <0.2.0 || >=0.1.6-0 <0.2.0 || >=0.1.7-0 <0.2.0 || >=0.2.0-0 <0.3.0 || >=0.2.1-0 <0.3.0 || >=0.2.2-0 <0.3.0","node":"^22.19.0 || >=24.9.0"},"exports":{".":{"default":"./index.mjs","types":"./types.d.ts"},"./cordis.patch.yml":"./cordis.patch.yml","./package.json":"./package.json"},"files":["index.mjs","types.d.ts","lib","cordis.patch.yml","README.md","README-zh.md","README-es.md","README-pt.md","README-hi.md","ARCHITECTURE.md","CHANGELOG.md","SECURITY.md","LICENSE","THIRD_PARTY_NOTICES.md"],"funding":{"type":"individual","url":"https://github.com/sponsors/PerryLink"},"homepage":"https://github.com/PerryLink/dsh-mask#readme","keywords":["dsh","dsh-plugin","deepseek-harness","deepseek","cordis","pii","mask","privacy","anonymization","security"],"license":"Apache-2.0","main":"./index.mjs","name":"dsh-mask","packageManager":"pnpm@11.7.0","peerDependencies":{"@deepseek-ai/cordis":"^4.0.5","@deepseek-ai/dsh-commands":">=0.1.2-rc.1 <0.2.0 || >=0.1.5-a